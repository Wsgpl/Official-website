# Server Configuration
PORT=3000
NODE_ENV=development

# MySQL Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=secret
DB_NAME=wingspann_dev

# Cloudflare Turnstile Keys
# In DEV, use Cloudflare's official dummy test keys:
# Sitekey (always passes): 1x00000000000000000000AA
# Secretkey (always passes): 1x0000000000000000000000000000000AA
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Email Provider Configuration (EMAIL_PROVIDER=smtp | resend | auto)
EMAIL_PROVIDER=smtp

# Microsoft 365 / Direct SMTP Settings
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=info@wingspannglobal.com
SMTP_PASS=your_mailbox_password_here
SMTP_SECURE=false

# Resend Email Fallback Configuration
RESEND_API_KEY=re_123456789

# In DEV, send all notifications to a test email address instead of production mailboxes
DEV_NOTIFICATION_EMAIL=test@example.com

# Session & Security
COOKIE_SECRET=development_cookie_secret_key_change_in_production

# Upload Storage Directory
UPLOAD_DIR=./uploads_dev
